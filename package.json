{
  "name": "@luolapeikko/zod-express-middleware",
  "version": "0.1.0",
  "description": "ExpressJS Zod Validation Middleware",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "lint": "biome check",
    "validate": "tsc --noEmit --project tsconfig.test.json"
  },
  "keywords": [
    "zod",
    "express",
    "middleware",
    "validation"
  ],
  "author": "mharj",
  "repository": "github:luolapeikko/zod-express-middleware",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@standard-schema/spec": "^1.1.0",
    "@tsconfig/node16": "^16.1.8",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^11.0.0",
    "express": "^5.2.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/express": ">= 4.0.0",
    "@types/express-serve-static-core": ">= 4.0.0",
    "express": "^4 || ^5",
    "zod": "^3 || ^4"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
